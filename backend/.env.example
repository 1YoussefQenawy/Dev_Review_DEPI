# ---- AI module (Member 5) ----
# Which AI provider to use: "mock" (default, free, no internet) or "gemini".
# Keep this on "mock" for ALL development and testing.
# Switch to "gemini" only for the final demonstration.
AI_PROVIDER=mock

# Only needed when AI_PROVIDER=gemini. NEVER commit the real key.
GEMINI_API_KEY=
# Copy the exact model name shown in Google AI Studio (names change over time).
GEMINI_MODEL=

# Request timeout in milliseconds (default 30000 = 30 seconds).
AI_TIMEOUT_MS=30000
# Maximum code size accepted, in characters (default 20000).
AI_MAX_INPUT_CHARS=20000
# Extra Gemini calls allowed ONLY when the reply was not valid JSON. 0 = never (default), max 1.
AI_MAX_REPAIR_ATTEMPTS=0
# After a quota error (HTTP 429), block new Gemini calls for this long (default 300000 = 5 min).
AI_QUOTA_COOLDOWN_MS=300000
